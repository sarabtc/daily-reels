# Copy to .env and fill in. Never commit .env.

# --- required ---------------------------------------------------------------
PIXABAY_KEY=
BUFFER_TOKEN=
BUFFER_CHANNEL_INSTAGRAM=

# --- optional channels (run: npm run channels) ------------------------------
BUFFER_CHANNEL_TIKTOK=
BUFFER_CHANNEL_YOUTUBE=

# --- fresh content every day ------------------------------------------------
# Without one of these the system cycles the 6 seed topics and repeats itself.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# CONTENT_MODEL=claude-sonnet-5

# --- optional ---------------------------------------------------------------
# Real music instead of the synthesised bed (free key at developer.jamendo.com).
# Dropping mp3 files into assets/music/ takes priority over this.
JAMENDO_CLIENT_ID=

# Handle burned into every video, e.g. @ryze.il. Leave empty for none.
BRAND_HANDLE=

# Voice and pace. Alternatives: en-US-GuyNeural, en-GB-RyanNeural.
# TTS_VOICE=en-US-ChristopherNeural
# TTS_RATE=+12%

# YouTube category: 22 = People & Blogs, 27 = Education, 26 = Howto & Style.
# YOUTUBE_CATEGORY_ID=22

# Fill a specific day instead of today. "tomorrow" or YYYY-MM-DD.
# Normally left unset — the nightly run fills the day it wakes up on.
# SCHEDULE_DATE=tomorrow
